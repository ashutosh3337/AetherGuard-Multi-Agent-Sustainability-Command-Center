# ─────────────────────────────────────────────────────────────────────────────
# AetherGuard environment template. Copy to `.env.local` (git-ignored).
#
# Defaults below run 100% offline against the Firebase Emulator Suite using a
# `demo-*` project id (no real GCP project or credentials needed).
#
# SECURITY MODEL
#  • NEXT_PUBLIC_* values are PUBLIC identifiers (Firebase web config is not a
#    secret — access is enforced by Auth, App Check and Firestore rules).
#  • Real secrets (e.g. GEMINI_API_KEY) are NEVER placed here for production.
#    They live in Secret Manager and are injected at runtime by App Hosting /
#    Cloud Run (see apphosting.yaml) or fetched via src/lib/server/secrets.ts.
#  • No service-account JSON keys: the server uses Application Default
#    Credentials (attached service account in prod, `gcloud auth
#    application-default login` locally).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public Firebase web config ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-aetherguard.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-aetherguard
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# App Check (reCAPTCHA Enterprise site key — public). Leave empty to disable locally.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Set true ONLY in local dev to print an App Check debug token to the console.
NEXT_PUBLIC_APP_CHECK_DEBUG=false

# ── Emulators (local only) ──────────────────────────────────────────────────
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
# Read by firebase-admin on the server so it talks to the emulators.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Server-only ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=demo-aetherguard
SESSION_COOKIE_MAX_AGE_DAYS=5
# Require a valid App Check token when creating sessions (set true in prod).
APP_CHECK_ENFORCE=false
# Extra allowed origins for state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000
